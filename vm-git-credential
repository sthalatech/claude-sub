#!/bin/sh
# git credential helper: answers github.com HTTPS requests with the PAT stored
# in Infisical (/vm-defaults/GH_TOKEN), fetched on demand, never written to disk.
[ "$1" = get ] || exit 0
host=""
while IFS='=' read -r k v; do [ "$k" = host ] && host=$v; done
[ "$host" = github.com ] || exit 0
tok=$(/usr/local/bin/vm-secret GH_TOKEN) || exit 0
[ -n "$tok" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$tok"
