[Unit]
Description=claude-sub@SFX@: Claude subscription to Anthropic Messages API proxy
Documentation=https://github.com/sthalatech/claude-sub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@LOGIN_USER@
Group=@LOGIN_GROUP@
StateDirectory=claude-sub@SFX@
Environment=CLAUDE_SUB_STATE=/var/lib/claude-sub@SFX@
EnvironmentFile=-/etc/claude-sub/infisical.env
Environment=INFISICAL_SECRET_NAME=@SECRET_NAME@
ExecStart=/usr/local/bin/claude-sub serve -addr :@PORT@ -public-url @PUBLIC_URL@
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
