[Unit]
Description=claude-sub@SFX@: publish refreshed tokens to the token vault
Documentation=https://github.com/sthalatech/claude-sub
After=claude-sub@SFX@.service network-online.target

[Service]
Type=oneshot
User=@LOGIN_USER@
Group=@LOGIN_GROUP@
StateDirectory=claude-sub@SFX@
Environment=CLAUDE_SUB_STATE=/var/lib/claude-sub@SFX@
EnvironmentFile=-/etc/claude-sub/infisical.env
Environment=INFISICAL_SECRET_NAME=@SECRET_NAME@
ExecStart=/usr/local/bin/claude-sub vault-sync
TimeoutStartSec=120
