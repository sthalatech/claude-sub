#!/bin/sh
# vm-secret NAME [PATH]  -> prints one secret's value from Infisical.
# Reads /etc/claude-sub/infisical.env (INFISICAL_URL, INFISICAL_PROJECT_ID,
# INFISICAL_ENVIRONMENT, and optionally INFISICAL_TOKEN or
# INFISICAL_CLIENT_ID/SECRET). With no credentials it relies on an exe.dev
# integration injecting the Authorization header at the network edge.
set -eu
[ -r /etc/claude-sub/infisical.env ] && . /etc/claude-sub/infisical.env
NAME=${1:?usage: vm-secret NAME [PATH]}
SPATH=${2:-${VM_SECRETS_PATH:-/vm-defaults}}
BASE=${INFISICAL_URL:?INFISICAL_URL not set}
TOKEN=${INFISICAL_TOKEN:-}
if [ -z "$TOKEN" ] && [ -n "${INFISICAL_CLIENT_ID:-}" ]; then
	TOKEN=$(curl -fsS -X POST "$BASE/api/v1/auth/universal-auth/login" \
		-H 'Content-Type: application/json' \
		-d "{\"clientId\":\"$INFISICAL_CLIENT_ID\",\"clientSecret\":\"$INFISICAL_CLIENT_SECRET\"}" |
		sed -n 's/.*"accessToken":"\([^"]*\)".*/\1/p')
fi
AUTH=""
[ -n "$TOKEN" ] && AUTH="Authorization: Bearer $TOKEN"
curl -fsS ${AUTH:+-H "$AUTH"} -G "$BASE/api/v3/secrets/raw/$NAME" \
	--data-urlencode "workspaceId=${INFISICAL_PROJECT_ID:?INFISICAL_PROJECT_ID not set}" \
	--data-urlencode "environment=${INFISICAL_ENVIRONMENT:-prod}" \
	--data-urlencode "secretPath=$SPATH" |
	sed -n 's/.*"secretValue":"\([^"]*\)".*/\1/p'
